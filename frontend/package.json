{
  "name": "betriebsrichtung-frontend",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "dev": "vite",
    "dev:metar": "sh ../scripts/dev-jobs.sh metar",
    "dev:forecast": "sh ../scripts/dev-jobs.sh forecast",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "version:patch": "npm version patch --no-git-tag-version && python3 ../scripts/sync_job_version.py",
    "version:minor": "npm version minor --no-git-tag-version && python3 ../scripts/sync_job_version.py",
    "version:major": "npm version major --no-git-tag-version && python3 ../scripts/sync_job_version.py",
    "prepare": "cd .. && husky frontend/.husky || true"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/vue": "1.49.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  }
}
